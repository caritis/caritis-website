# --- Formulaire de contact (serveur uniquement, jamais exposé au navigateur) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
# Expéditeur affiché (doit être autorisé par le fournisseur SMTP)
SMTP_FROM=
# Destinataire des messages du formulaire — ne jamais afficher côté client
CONTACT_TO_EMAIL=

# --- Site ---
# Documentaire uniquement : l'URL canonique est une constante de build,
# définie par SITE_URL dans src/lib/site.ts. Aucun code ne lit cette variable.
SITE_URL=https://caritis.fr
