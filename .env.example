# --- Formulaire de contact (serveur uniquement, jamais exposé au navigateur) ---

# Transport principal : Resend (API HTTP). Le domaine caritis.fr y est vérifié.
RESEND_API_KEY=
# Destinataire de tous les messages du formulaire.
# Valeur par défaut si non renseigné : contact@caritis.fr
CONTACT_TO_EMAIL=contact@caritis.fr
# Expéditeur affiché — doit appartenir à un domaine vérifié chez Resend.
# Valeur par défaut si non renseigné : CARITIS <contact@caritis.fr>
CONTACT_FROM_EMAIL=

# --- Repli SMTP (optionnel) ---
# Utilisé uniquement si RESEND_API_KEY est absent.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Site ---
# Documentaire uniquement : l'URL canonique est une constante de build,
# définie par SITE_URL dans src/lib/site.ts. Aucun code ne lit cette variable.
SITE_URL=https://caritis.fr
